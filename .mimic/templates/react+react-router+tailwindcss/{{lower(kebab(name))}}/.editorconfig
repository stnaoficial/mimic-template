root = true

[*]
end_of_line = lf
charset = utf-8

[*.json]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.css]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[{*.ts,*.tsx,*.js,*.jsx}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
block_comment_start = /**
block_comment = *
block_comment_end = */